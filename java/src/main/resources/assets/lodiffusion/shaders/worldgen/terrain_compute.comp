#version 450
// =============================================================================
// terrain_compute.comp
// GPU Shadow Router — Minecraft terrain density field compute shader.
//
// Computes a 16 × Y_LEVELS × 16 density field for one chunk column.
// Density > 0 → solid block; density <= 0 → air.
//
// GOAL: Vanilla-parity Overworld NoiseRouter / finalDensity evaluation.
// PARITY STATUS: partial — see IMPLEMENTATION STATUS near computeFinalDensity().
// Loaded and concatenated by com.rhythmatician.lodiffusion.gpu.GlslShaderLoader:
//   [this file from #version to before "// --- INCLUDE CUT ---"]
//   + mc_improved_noise.glsl
//   + mc_perlin_noise.glsl
//   + mc_normal_noise.glsl
//   [this file from "// --- INCLUDE CUT ---" to end]
// =============================================================================

// One workgroup = one 16×16 chunk column.
// Thread (localX, localZ) handles all Y values for its block column.
layout(local_size_x = 16, local_size_y = 1, local_size_z = 16) in;

// ---------------------------------------------------------------------------
// Constants matching vanilla Overworld dimensions
// ---------------------------------------------------------------------------
#define Y_MIN       (-64)
#define Y_MAX       320
#define Y_LEVELS    384      // Y_MAX - Y_MIN
#define MAX_OCTAVES 16

// Sea level below which air blocks become water
#define SEA_LEVEL   62

// Material type codes written to block_out by the surface pass.
// Translated to Voxy block IDs on the Java side (ShaderSectionWriter).
#define MAT_AIR     0
#define MAT_STONE   1
#define MAT_WATER   2
#define MAT_GRASS   3   // topmost solid at Y >= SEA_LEVEL
#define MAT_DIRT    4   // 1-3 blocks below grass surface

// ---------------------------------------------------------------------------
// SSBOs — populated once at world load by ShadowRouterExtractor.java
//         (the shadow router bootstrap: mirrors vanilla NoiseRouter onto GPU)
// ---------------------------------------------------------------------------

// ImprovedNoise origin offsets: 4 floats per instance [xo, yo, zo, _pad]
layout(binding = 0, std430) buffer ImprovedOrigins {
    float data[];
} improved_origins;

// ImprovedNoise permutation tables: 256 uints per instance, flat
layout(binding = 1, std430) buffer ImprovedPerms {
    uint data[];
} improved_perms;

// PerlinNoise integer config (stride = PN_INT_STRIDE ints per instance):
//   [0]           : num_octaves
//   [1..3]        : _pad
//   [4 + octave]  : improved_noise_index  (-1 = null octave)
#define PN_INT_STRIDE   (4 + MAX_OCTAVES)
layout(binding = 2, std430) buffer PerlinInt {
    int data[];
} perlin_int;

// PerlinNoise float config (stride = PN_FLOAT_STRIDE floats per instance):
//   [0]           : lowestFreqInputFactor
//   [1]           : lowestFreqValueFactor
//   [2 + octave]  : amplitude[octave]
#define PN_FLOAT_STRIDE (2 + MAX_OCTAVES)
layout(binding = 3, std430) buffer PerlinFloat {
    float data[];
} perlin_float;

// NormalNoise integer config: 4 ints per instance
//   [0] : first_perlin_idx
//   [1] : second_perlin_idx
//   [2..3] : _pad
layout(binding = 4, std430) buffer NormalNoiseInt {
    int data[];
} normal_noise_int;

// NormalNoise float config: 1 float per instance
//   [0] : value_factor
layout(binding = 5, std430) buffer NormalNoiseFloat {
    float data[];
} normal_noise_float;

// Spline control point data (packed).
// Layout: [numPoints, x0, y0, x1, y1, ...] per spline, addressed by spline_offsets UBO.
// Used for TerrainProvider cubic splines (continents→offset, etc.).
layout(binding = 6, std430) buffer SplineData {
    float data[];
} spline_data;

// TerrainShaperMLP weights and biases (SSBO).
// Flattened layout:
//   [0..127]    = W1[32,4] row-major (input layer weights)
//   [128..159]  = b1[32] (input layer bias)
//   [160..1183] = W2[32,32] row-major (hidden layer weights)
//   [1184..1215] = b2[32] (hidden layer bias)
//   [1216..1248] = W3[3,32] row-major (output layer weights)
//   [1249..1251] = b3[3] (output layer bias)
layout(binding = 9, std430) buffer ShapeMlpWeights {
    float data[];
} shape_mlp_weights;

// TerrainShaperMLP configuration (UBO).
// Stores layer sizes and byte offsets into the weights SSBO.
layout(binding = 10, std140) uniform ShapeMlpConfig {
    int in_size;         // 4
    int hidden_size;     // 32
    int out_size;        // 3
    int _pad0;
    
    int w1_offset;       // 0
    int b1_offset;       // 128
    int w2_offset;       // 160
    int b2_offset;       // 1184
    int w3_offset;       // 1216
    int b3_offset;       // 1249
} shape_mlp_cfg;

// Output density field for the current chunk dispatch.
// Indexed: [localX + 16 * localZ] * Y_LEVELS + (blockY - Y_MIN)
// i.e., column-major XZ, then Y.
layout(binding = 7, std430) buffer DensityOutput {
    float data[];
} density_out;

// Output material type for each block (same indexing as density_out).
// Material codes (see MAT_xxx constants below) are written after the density
// pass so the Java side can build Voxy sections without re-running the CPU.
layout(binding = 11, std430) buffer BlockOutput {
    int data[];
} block_out;

// Biome parameter palette — uploaded once at world load by BiomePaletteSSBO.java.
// Stride = 16 floats per entry:
//   [0..1]   temperature   (min, max), de-quantised (÷10000)
//   [2..3]   humidity      (min, max)
//   [4..5]   continentalness (min, max)
//   [6..7]   erosion       (min, max)
//   [8..9]   depth         (min, max)
//   [10..11] weirdness     (min, max)
//   [12]     offset        (7th dimension; query-point is always 0)
//   [13]     biome_id      (bit-cast float — recover with floatBitsToInt)
//   [14..15] pad
#define BIOME_PALETTE_STRIDE 16
layout(binding = 12, std430) buffer BiomePalette {
    float data[];
} biome_palette;

// Per-dispatch biome output: one int per quart-Y lattice point.
// 4 (qx) × 4 (qz) × BIOME_Y_LEVELS (qy) entries.
// Index: qx * (4 * BIOME_Y_LEVELS) + qz * BIOME_Y_LEVELS + qy
#define BIOME_Y_LEVELS  (Y_LEVELS / 4)    // = 96
layout(binding = 13, std430) buffer BiomeOutput {
    int data[];
} biome_out;

// ---------------------------------------------------------------------------
// Uniform buffer: dimension-specific router configuration.
// Populated from the live NoiseRouter at world load.
// ---------------------------------------------------------------------------
layout(binding = 8, std140) uniform RouterConfig {
    // Chunk origin in block coords (set per dispatch via push constant or update)
    int chunk_origin_x;
    int chunk_origin_z;
    int _pad0;
    int _pad1;

    // NormalNoise indices for named router outputs
    int nn_continents;      // NoiseRouter.continents (horizontal shaping)
    int nn_erosion;         // NoiseRouter.erosion
    int nn_ridges;          // NoiseRouter.ridges (weirdness)
    int nn_depth_noise;     // The "sloped cheese" base noise for finalDensity
    int nn_jagged;          // Jaggedness noise (high-freq vertical shape)
    int nn_shift_a;         // X/Z coordinate shift noise
    int nn_shift_b;         // X/Z coordinate shift noise (Z component)
    int _pad2;

    // YClampedGradient parameters for the depth gradient
    // (from NoiseRouterData, varies slightly by worldgen preset)
    float grad_from_y;      // Overworld default: -64
    float grad_to_y;        // Overworld default:  320
    float grad_from_value;  // Overworld default:   1.5
    float grad_to_value;    // Overworld default:  -1.5

    // Spline table offsets (index into spline_data.data[] for each named spline)
    int spline_offset_offset;   // terrain offset spline
    int spline_factor_offset;   // terrain factor (vertical scale) spline
    int spline_jagged_offset;   // jaggedness modifier spline
    int _pad3;

    // WS-4.1a: Cave noise NormalNoise indices (-1 = disabled / not yet wired)
    // Indices into the flat NormalNoise arrays at bindings 4 and 5.
    int nn_entrances;           // overworld/caves/entrances  (cave bore openings)
    int nn_cheese_caves;        // overworld/caves/pillars    (large spherical caves)
    int nn_spaghetti_2d;        // overworld/caves/spaghetti_2d  (2D tunnel axis)
    int nn_roughness;           // overworld/caves/spaghetti_roughness_function
    int nn_noodle;              // overworld/caves/noodle     (thin connected tunnels)
    int nn_temperature;         // NoiseRouter.temperature  (biome climate signal)
    int nn_vegetation;          // NoiseRouter.vegetation   (= humidity, biome climate signal)
    int biome_palette_count;    // number of entries in BiomePalette SSBO (binding 12; 0 = disabled)

    // WS-quart: Aquifer + ore vein NormalNoise indices (-1 = not wired)
    // Used by quart_noise_compute.comp; present here for UBO layout compatibility.
    int nn_barrier;             // NoiseRouter.barrierNoise()          — aquifer pressure barrier
    int nn_floodedness;         // NoiseRouter.fluidLevelFloodedness() — aquifer flood level
    int nn_spread;              // NoiseRouter.fluidLevelSpread()      — aquifer spread randomization
    int nn_lava;                // NoiseRouter.lavaNoise()             — lava vs water selection
    int nn_vein_toggle;         // NoiseRouter.veinToggle()            — copper/iron toggle
    int nn_vein_ridged;         // NoiseRouter.veinRidged()            — ridged vein shape
    int nn_vein_gap;            // NoiseRouter.veinGap()               — vein gap/holes
    int _pad_aq;                // align to 144 bytes (9 × 16)
    // total: 144 bytes (std140 requires multiple-of-16 struct size)
} router;

