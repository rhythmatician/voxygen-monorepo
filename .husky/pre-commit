#!/bin/sh
# Block direct commits to main — open a branch instead.
# Bypass with --no-verify only if you know what you're doing.

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" = "main" ]; then
  echo "Direct commits to 'main' are blocked." >&2
  echo "Create a branch first: git switch -c <branch-name>" >&2
  echo "If you absolutely must bypass: git commit --no-verify" >&2
  exit 1
fi

# Preserve existing pre-commit framework hooks if configured.
# .pre-commit-config.yaml is the source of truth; run it when available.
if [ -f ".pre-commit-config.yaml" ]; then
  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --hook-stage pre-commit "$@"
    exit $?
  fi
  # Windows venv fallback (repo was set up on Windows)
  if [ -x "training/.venv/Scripts/python.exe" ]; then
    "training/.venv/Scripts/python.exe" -m pre_commit run --hook-stage pre-commit "$@"
    exit $?
  fi
  # Generic fallback: try python on PATH
  if command -v python >/dev/null 2>&1; then
    python -m pre_commit run --hook-stage pre-commit "$@" 2>/dev/null
    if [ $? -ne 127 ]; then exit $?; fi
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -m pre_commit run --hook-stage pre-commit "$@" 2>/dev/null
    if [ $? -ne 127 ]; then exit $?; fi
  fi
fi
