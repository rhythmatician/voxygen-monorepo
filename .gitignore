# .gitignore

graphify-out/

# --- Mod Gradle build (mod/) ---
mod/.gradle/
mod/build/
# keep wrapper jar
!mod/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Minecraft run outputs (mod/run)
mod/run/mods/
mod/run/logs/
mod/run/crash-reports/
mod/run/screenshots/
mod/run/saves/
mod/run/resourcepacks/
mod/run/shaderpacks/

# Training artifacts (training/)
training/__pycache__/
training/.pytest_cache/
training/.mypy_cache/
training/*.egg-info/
training/.venv/
training/runs/
training/artifacts/

# Sandcastle mutable provenance (host-side, out of data plane)
.sandcastle/provenance/
.sandcastle/worktrees/

# Generic
*.log
*.tmp
.dmypy.json
tmp/
node_modules/

# VS Code internal diagnostics
.vscode/prompt-diagnostics.json
tree_output.txt

# Sandcastle generated caches
.sandcastle/.doctor-cache.json

# Research scratch (uncommitted exploration, not docs/external)
research-scratch.md
research-vanilla-seams.md
verify.tmp

# Canary/Migration evidence logs (ignored, generated receipts)
.sandcastle/logs/

# Java
libraries/

# Minecraft Servers
eula.txt
server.properties
versions/
logs/
tools/server-harness/runtime/
tools/data-harvester/build/
tools/data-harvester/.gradle/
# keep data-harvester wrapper jar (mirrors mod rule)
!tools/data-harvester/gradle/wrapper/gradle-wrapper.jar
.ci/.voxy-cache/
