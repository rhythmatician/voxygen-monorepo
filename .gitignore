# .gitignore

graphify-out/

# --- Java Gradle build (java/) ---
java/.gradle/
java/build/
# keep wrapper jar
!java/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Minecraft run outputs (java/run)
java/run/mods/
java/run/logs/
java/run/crash-reports/
java/run/screenshots/
java/run/saves/
java/run/resourcepacks/
java/run/shaderpacks/

# Python artifacts (python/)
python/__pycache__/
python/.pytest_cache/
python/.mypy_cache/
python/*.egg-info/
python/.venv/
python/runs/
python/artifacts/

# Sandcastle mutable provenance (host-side, out of data plane)
.sandcastle/provenance/
.sandcastle/worktrees/

# Generic
*.log
*.tmp
.dmypy.json
tmp/
node_modules/

# VS Code internal diagnostics
.vscode/prompt-diagnostics.json
tree_output.txt

# Sandcastle generated caches
.sandcastle/.doctor-cache.json

# Research scratch (uncommitted exploration, not docs/external)
research-scratch.md
research-vanilla-seams.md
verify.tmp

# Canary/Migration evidence logs (ignored, generated receipts)
.sandcastle/logs/
