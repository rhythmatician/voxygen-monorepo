# Gradle wrappers: POSIX shell scripts need lf, Windows batch need crlf
/gradlew        text eol=lf
/java/gradlew   text eol=lf
/tools/data-harvester/gradlew text eol=lf
*.bat           text eol=crlf
*.onnx filter=lfs diff=lfs merge=lfs -text
graphify-out/graph.json merge=graphify
.husky/* text eol=lf
.claude/**/* text eol=lf
.claude/* text eol=lf
